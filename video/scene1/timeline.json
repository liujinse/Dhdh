 "lines": [
  {
   "who": "jia",
   "text": "王工，我们甲队已经单独干了一个月，",
   "start": 1.2,
   "end": 4.011632653061224
  },
  {
   "who": "jia",
   "text": "球场建设工程完成了三分之一。",
   "start": 4.261632653061224,
   "end": 6.859455782312925
  },
  {
   "who": "yi",
   "text": "我们乙队刚进场，",
   "start": 7.459455782312925,
   "end": 8.823061224489795
  },
  {
   "who": "yi",
   "text": "计划再和甲队一起干半个月能完成球场建设工程。",
   "start": 9.073061224489795,
   "end": 13.477301587301586
  },
  {
   "who": "wang",
   "text": "同学们好，我是项目负责人王工。",
   "start": 14.077301587301585,
   "end": 16.269614512471655
  },
  {
   "who": "wang",
   "text": "现在就想请你们帮我们算一算：",
   "start": 16.519614512471655,
   "end": 18.49331065759637
  },
  {
   "who": "wang",
   "text": "哪个队效率更高，后面该重点依靠谁？",
   "start": 18.74331065759637,
   "end": 21.843151927437642
  },
  {
   "who": "wang",
   "text": "你们就是我们学校的数学顾问团，",
   "start": 22.093151927437642,
   "end": 24.258480725623585
  },
  {
   "who": "wang",
   "text": "算出来的结果我们会直接用。",
   "start": 24.508480725623585,
   "end": 26.5797052154195
  }
 ]
