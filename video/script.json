{
  "voices": {
    "anan": {"name": "安安", "voice": "zh-CN-XiaoyiNeural"},
    "xiaoyu": {"name": "小宇", "voice": "zh-CN-YunxiaNeural"}
  },
  "scenes": [
    {"id": "intro", "title": "", "lines": [
      ["xiaoyu", "安安，学校旁边那块空地，怎么围起来啦？", "+0%", "+0Hz"],
      ["anan", "那里要建一座地下体育馆哦！", "+0%", "+6Hz"],
      ["xiaoyu", "地下？体育馆要藏到地底下？", "+0%", "+8Hz"],
      ["anan", "没错！跟我一起，看看它是怎么一步步建成的吧！", "+0%", "+5Hz"]
    ]},
    {"id": "why", "title": "为什么建在地下", "lines": [
      ["anan", "城市里的土地，可宝贵啦。", "-5%", "+0Hz"],
      ["anan", "把体育馆放到地下，地面还能留给操场和草坪。", "-5%", "+0Hz"],
      ["anan", "而且地下冬暖夏凉，还特别安静。", "-5%", "+2Hz"],
      ["xiaoyu", "哇，真是一举三得！", "+0%", "+8Hz"]
    ]},
    {"id": "survey", "step": 1, "title": "测量放线", "lines": [
      ["anan", "第一步，测量放线。", "-5%", "+3Hz"],
      ["anan", "测量员用全站仪，在地上标出体育馆的位置和大小。", "-5%", "+0Hz"],
      ["xiaoyu", "就像画画前，先打好草稿！", "+0%", "+5Hz"]
    ]},
    {"id": "piles", "step": 2, "title": "打围护桩", "lines": [
      ["anan", "第二步，给大坑穿上“铠甲”。", "-5%", "+3Hz"],
      ["anan", "钻机沿着四周，往地下打进一根根结实的桩。", "-5%", "+0Hz"],
      ["anan", "它们连成一圈围护墙，挖坑的时候，旁边的土就不会塌下来。", "-5%", "+0Hz"]
    ]},
    {"id": "dewater", "step": 3, "title": "基坑降水", "lines": [
      ["xiaoyu", "挖深了，会不会冒出水来呀？", "+0%", "+6Hz"],
      ["anan", "好问题！地底下藏着地下水。", "-5%", "+4Hz"],
      ["anan", "所以要先打好降水井，用水泵把水抽走，让坑里保持干燥。", "-5%", "+0Hz"]
    ]},
    {"id": "dig", "step": 4, "title": "土方开挖", "lines": [
      ["anan", "第四步，开挖啦！", "+0%", "+6Hz"],
      ["anan", "挖掘机一层一层往下挖，渣土车把土运走。", "-5%", "+0Hz"],
      ["anan", "每挖一层，就架上一道钢支撑，把围护墙牢牢顶住。", "-5%", "+0Hz"],
      ["anan", "这叫“先撑后挖”，安全第一！", "-5%", "+4Hz"],
      ["xiaoyu", "哇，坑好深呀，差不多有四层楼那么深！", "+0%", "+8Hz"]
    ]},
    {"id": "waterproof", "step": 5, "title": "铺设防水", "lines": [
      ["anan", "第五步，做防水。", "-5%", "+3Hz"],
      ["anan", "坑底先铺一层混凝土垫层，再贴上防水卷材。", "-5%", "+0Hz"],
      ["anan", "就像给体育馆，穿上一件大雨衣。", "-5%", "+4Hz"]
    ]},
    {"id": "structure", "step": 6, "title": "钢筋混凝土", "lines": [
      ["anan", "第六步，搭“骨架”，长“肌肉”。", "-5%", "+4Hz"],
      ["anan", "工人们把钢筋绑成整整齐齐的网，这是体育馆的骨架。", "-5%", "+0Hz"],
      ["anan", "泵车再把混凝土送下来，浇出底板、墙和柱子。", "-5%", "+0Hz"],
      ["xiaoyu", "等混凝土变硬，就特别结实啦！", "+0%", "+6Hz"]
    ]},
    {"id": "roof", "step": 7, "title": "封顶回填", "lines": [
      ["anan", "第七步，盖上屋顶。", "-5%", "+3Hz"],
      ["anan", "顶板做好以后，拆掉临时的钢支撑，再把土填回上面。", "-5%", "+0Hz"],
      ["anan", "种上草坪，铺好跑道，地面又变回漂亮的操场啦！", "-5%", "+5Hz"]
    ]},
    {"id": "interior", "step": 8, "title": "内部装修", "lines": [
      ["anan", "最后一步，内部装修。", "-5%", "+3Hz"],
      ["anan", "装上明亮的灯和通风管道，铺上有弹性的木地板。", "-5%", "+0Hz"],
      ["anan", "再挂好篮球架，画上球场线。", "-5%", "+2Hz"]
    ]},
    {"id": "finale", "title": "", "lines": [
      ["xiaoyu", "哇！地下体育馆建好啦！", "+0%", "+10Hz"],
      ["xiaoyu", "以后下雨天，也能痛痛快快地打球了！", "+0%", "+8Hz"],
      ["anan", "走，一起去运动吧！我们下次见！", "+0%", "+8Hz"]
    ]}
  ]
}
